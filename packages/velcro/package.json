{
  "name": "@charm-ux/velcro",
  "version": "0.1.0",
  "private": true,
  "description": "Velcro component library: Shoelace-style components on @charm-ux/core (prototype; badge, button, divider, progress-ring, skeleton and spinner only).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./button/class": {
      "types": "./dist/components/button/class.d.ts",
      "import": "./dist/components/button/class.js"
    },
    "./divider": {
      "types": "./dist/components/divider/index.d.ts",
      "import": "./dist/components/divider/index.js"
    },
    "./progress-ring": {
      "types": "./dist/components/progress-ring/index.d.ts",
      "import": "./dist/components/progress-ring/index.js"
    },
    "./progress-ring/class": {
      "types": "./dist/components/progress-ring/class.d.ts",
      "import": "./dist/components/progress-ring/class.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js"
    },
    "./spinner/class": {
      "types": "./dist/components/spinner/class.d.ts",
      "import": "./dist/components/spinner/class.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/components/skeleton/index.js"
    },
    "./skeleton/class": {
      "types": "./dist/components/skeleton/class.d.ts",
      "import": "./dist/components/skeleton/class.js"
    },
    "./themes/light.css": "./themes/light.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js",
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "plop --plopfile plopfile.mjs"
  },
  "dependencies": {
    "@charm-ux/core": "0.5.2",
    "lit": "3.3.3"
  }
}
