    },
    "./visually-hidden/class": {
      "types": "./dist/components/visually-hidden/class.d.ts",
      "import": "./dist/components/visually-hidden/class.js"
    },
    "./themes/dark.css": "./themes/dark.css",
    "./themes/light.css": "./themes/light.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js",
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "plop --plopfile plopfile.mjs"
  },
  "dependencies": {
    "@charm-ux/core": "0.5.2",
    "lit": "3.3.3"
  }
