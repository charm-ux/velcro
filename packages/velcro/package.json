{
  "name": "@charm-ux/velcro",
  "version": "0.1.0",
  "private": true,
  "description": "Velcro component library: Shoelace-style components on @charm-ux/core (prototype; badge, button, card, divider, format-bytes, format-date, format-number, progress-bar, progress-ring, resize-observer, skeleton, spinner and visually-hidden only).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./button/class": {
      "types": "./dist/components/button/class.d.ts",
      "import": "./dist/components/button/class.js"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js"
    },
    "./card/class": {
      "types": "./dist/components/card/class.d.ts",
      "import": "./dist/components/card/class.js"
    },
    "./divider": {
      "types": "./dist/components/divider/index.d.ts",
      "import": "./dist/components/divider/index.js"
    },
    "./format-bytes": {
      "types": "./dist/components/format-bytes/index.d.ts",
      "import": "./dist/components/format-bytes/index.js"
    },
    "./format-bytes/class": {
      "types": "./dist/components/format-bytes/class.d.ts",
      "import": "./dist/components/format-bytes/class.js"
    },
    "./format-date": {
      "types": "./dist/components/format-date/index.d.ts",
      "import": "./dist/components/format-date/index.js"
    },
    "./format-date/class": {
      "types": "./dist/components/format-date/class.d.ts",
      "import": "./dist/components/format-date/class.js"
    },
    "./format-number": {
      "types": "./dist/components/format-number/index.d.ts",
      "import": "./dist/components/format-number/index.js"
    },
    "./format-number/class": {
      "types": "./dist/components/format-number/class.d.ts",
      "import": "./dist/components/format-number/class.js"
    },
    "./progress-bar": {
      "types": "./dist/components/progress-bar/index.d.ts",
      "import": "./dist/components/progress-bar/index.js"
    },
    "./progress-bar/class": {
      "types": "./dist/components/progress-bar/class.d.ts",
      "import": "./dist/components/progress-bar/class.js"
    },
    "./progress-ring": {
      "types": "./dist/components/progress-ring/index.d.ts",
      "import": "./dist/components/progress-ring/index.js"
    },
    "./progress-ring/class": {
      "types": "./dist/components/progress-ring/class.d.ts",
      "import": "./dist/components/progress-ring/class.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js"
    },
    "./spinner/class": {
      "types": "./dist/components/spinner/class.d.ts",
      "import": "./dist/components/spinner/class.js"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/components/skeleton/index.js"
    },
    "./skeleton/class": {
      "types": "./dist/components/skeleton/class.d.ts",
      "import": "./dist/components/skeleton/class.js"
    },
    "./resize-observer": {
      "types": "./dist/components/resize-observer/index.d.ts",
      "import": "./dist/components/resize-observer/index.js"
    },
    "./resize-observer/class": {
      "types": "./dist/components/resize-observer/class.d.ts",
      "import": "./dist/components/resize-observer/class.js"
    },
    "./visually-hidden": {
      "types": "./dist/components/visually-hidden/index.d.ts",
